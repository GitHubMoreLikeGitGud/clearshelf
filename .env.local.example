# Copy to .env.local (gitignored) and fill in. Placeholders only in this file.
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_JDBC_JAR=/path/to/zetaris-platform/jdbc/ndp-jdbc-driver-2.4.3.1-7eff043-driver.jar
ZETARIS_ADMIN_USERNAME=
ZETARIS_ADMIN_PASSWORD=
ZETARIS_READER_USERNAME=clearshelf_agent
ZETARIS_READER_PASSWORD=
CLEARSHELF_USER_AGENT="ClearShelf/0.1 <owner-contact-email>"
CLEARSHELF_CONTRACT_SECRET=<generate: 32 random bytes hex>
OLLAMA_URL=http://127.0.0.1:11434
CLEARSHELF_MODEL=nemotron-3-nano:4b
CLEARSHELF_MODEL_FALLBACK=nemotron-mini:4b
OPS_BASE_URL_FOR_ZETARIS=http://clearshelf-ops
GATEWAY_URL=http://127.0.0.1:8791
UI_PORT=8790
# Optional: poll the live recall watch every N minutes (5 or more); empty = poll only on request.
CLEARSHELF_WATCH_EVERY_MIN=
